<resources>
    <string name="gamepad_bindings_title">Controller key bindings</string>
    <string name="gamepad_bindings_summary">Choose the keyboard key for each controller input in HD mode.</string>
    <string name="gamepad_bindings_help">Tap an input to choose a keyboard key. Choices save automatically; restart the HD game to apply them. Default keeps the original action shown for pointer mode. Custom keys apply in both pointer and captured cursor modes. The directional stick is the right stick in pointer mode and the left stick when the cursor is captured; the other stick still moves the mouse.</string>
    <string name="gamepad_bindings_inputs_title">Controller inputs</string>
    <string name="gamepad_binding_default">Default: %1$s</string>
    <string name="gamepad_binding_unbound">Unbound</string>
    <string name="gamepad_binding_mouse_left">Left mouse button</string>
    <string name="gamepad_binding_mouse_right">Right mouse button</string>
    <string name="gamepad_binding_scroll_up">Scroll up</string>
    <string name="gamepad_binding_scroll_down">Scroll down</string>
    <string name="gamepad_bindings_reset_title">Reset key bindings</string>
    <string name="gamepad_bindings_reset_summary">Restore all original controller actions.</string>
    <string name="gamepad_bindings_reset_message">Reset all controller key bindings to their defaults? Restart the HD game afterward to apply the reset.</string>
